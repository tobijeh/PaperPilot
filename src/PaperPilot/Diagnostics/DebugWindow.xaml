<Window x:Class="PaperPilot.DebugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paper Pilot — Debug"
        Width="1150" Height="860" MinWidth="700" MinHeight="450"
        Background="{StaticResource Cream}" Foreground="{StaticResource Navy}"
        FontFamily="Segoe UI" FontSize="13" ShowActivated="True"
        Icon="pack://application:,,,/Assets/icon.png">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource PilotBlue}" />
            <Setter Property="BorderBrush" Value="{StaticResource DeepBlue}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Navy}" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="120" />
        </Grid.RowDefinitions>

        <!-- (row 0 unused: updates now live in Settings › About) -->
        <Border Grid.Row="0" x:Name="UpdateBanner" Visibility="Collapsed" />

        <!-- Instructions -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Periwinkle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <TextBlock TextWrapping="Wrap">
                <Run FontWeight="SemiBold">Turn on:</Run>
                click into the window you preach from (e.g. Google Docs), then press
                <Run x:Name="HotkeyRun" FontWeight="SemiBold">F3</Run>.
                The pill appears and Paper Pilot locks onto that window. Press it again to turn off.
                <Run FontWeight="SemiBold">Then:</Run> Calibrate, try “Scroll down”, and use your wheel, keys,
                touchpad or clicker during a slow scroll — it should stop instantly.
            </TextBlock>
        </Border>

        <!-- Target info -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Periwinkle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <TextBlock x:Name="TargetText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="No target yet." />
        </Border>

        <!-- Controls -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Read" Width="54" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="ReadButton" Content="Read now" Click="ReadButton_Click" IsEnabled="False" />
                <Button Content="Turn on in 3 s" Click="LockDelayedButton_Click"
                        ToolTip="Gives you 3 seconds to click into the target window, then turns Paper Pilot on for it." />
                <CheckBox x:Name="AutoReadCheck" Content="Auto-read every 700 ms" Checked="AutoReadCheck_Changed" Unchecked="AutoReadCheck_Changed" />
                <CheckBox x:Name="OverlayCheck" Content="Show boxes on screen" Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
                <CheckBox x:Name="PreviewCheck" Content="Show captured image" IsChecked="True" />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Scroll" Width="54" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="CalibrateButton" Content="Calibrate" Click="Calibrate_Click" IsEnabled="False"
                        ToolTip="Scrolls one wheel notch down, measures it, and scrolls back." />
                <TextBox x:Name="ScrollPxBox" Text="200" Width="56" VerticalContentAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="px" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="ScrollButton" Content="Scroll down" Click="Scroll_Click" IsEnabled="False" />
                <CheckBox x:Name="SlowCheck" Content="Slow (5 s)" ToolTip="Gives you time to interrupt it with your own input." />
                <CheckBox x:Name="DelayCheck" Content="Start after 3 s" IsChecked="True"
                          ToolTip="So you can click into your document first and check focus doesn't change." />
                <TextBlock x:Name="ScrollInfo" VerticalAlignment="Center" Text="Not calibrated." />
            </WrapPanel>
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Bubble" Width="54" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Following" Tag="Following" Click="PillState_Click" />
                <Button Content="Holding" Tag="Holding" Click="PillState_Click" />
                <Button Content="Paused" Tag="Paused" Click="PillState_Click" />
                <Button Content="Problem" Tag="Problem" Click="PillState_Click" />
                <Button Content="Off" Tag="Off" Click="PillState_Click" />
                <CheckBox x:Name="SimulateVoiceCheck" Content="Simulate voice" Margin="8,0,0,0"
                          Checked="SimulateVoice_Changed" Unchecked="SimulateVoice_Changed"
                          ToolTip="Feeds made-up voice levels to the bubble's trail (the microphone arrives in Milestone 3)." />
                <TextBlock x:Name="StateText" VerticalAlignment="Center" Margin="8,0,0,0" Text="State: Off" />
                <TextBlock x:Name="ManualText" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="SemiBold" />
            </WrapPanel>
            <WrapPanel>
                <TextBlock Text="App" Width="54" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Content="Settings…" Click="Settings_Click" />
                <Button Content="Save snapshot" Click="SaveSnapshot_Click" Background="{StaticResource Navy}"
                        ToolTip="Saves the captured image and the line list to the log folder." />
                <Button Content="Open log folder" Click="OpenLogFolder_Click" Background="{StaticResource Navy}" />
            </WrapPanel>
        </StackPanel>

        <!-- Lines + preview -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="LinesList" Grid.Column="0" BorderBrush="{StaticResource Periwinkle}" FontSize="12"
                      SelectionChanged="LinesList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Index}" />
                        <GridViewColumn Header="Screen X" Width="64" DisplayMemberBinding="{Binding Screen.X}" />
                        <GridViewColumn Header="Screen Y" Width="64" DisplayMemberBinding="{Binding Screen.Y}" />
                        <GridViewColumn Header="W" Width="52" DisplayMemberBinding="{Binding Screen.Width}" />
                        <GridViewColumn Header="H" Width="44" DisplayMemberBinding="{Binding Screen.Height}" />
                        <GridViewColumn Header="Words" Width="48" DisplayMemberBinding="{Binding Words.Count}" />
                        <GridViewColumn Header="Text" Width="480" DisplayMemberBinding="{Binding Text}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" BorderBrush="{StaticResource Periwinkle}" BorderThickness="1" Background="White">
                <Viewbox Stretch="Uniform" StretchDirection="Both">
                    <Grid x:Name="PreviewGrid">
                        <Image x:Name="PreviewImage" Stretch="None" />
                        <Canvas x:Name="PreviewCanvas" />
                    </Grid>
                </Viewbox>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="5" Margin="0,8,0,4" TextWrapping="Wrap" FontWeight="SemiBold" Text="Ready." />

        <TextBox x:Name="LogBox" Grid.Row="6" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 BorderBrush="{StaticResource Periwinkle}" Background="White" Foreground="{StaticResource Navy}" />
    </Grid>
</Window>
