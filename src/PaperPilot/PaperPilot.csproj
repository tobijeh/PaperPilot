<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      The 22621 projection gives us newer Windows.Graphics.Capture members (e.g. turning off the
      yellow capture border on Windows 11). They are only used behind runtime API checks, so the
      app still runs on Windows 10 19041+.
    -->
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>PaperPilot</RootNamespace>
    <AssemblyName>PaperPilot</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <Product>Paper Pilot</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF app: per-monitor DPI v2 is set in app.manifest on purpose (the WinForms hint does not apply). -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Lets the project build on non-Windows machines (CI, dev containers). Harmless on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of every file. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PaperPilot.Core\PaperPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
    <Resource Include="..\..\assets\fonts\*.ttf" LinkBase="Assets\Fonts" />
  </ItemGroup>

</Project>
