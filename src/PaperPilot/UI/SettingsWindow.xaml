<Window x:Class="PaperPilot.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Paper Pilot" Width="880" Height="640" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource AppFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True"
        Icon="pack://application:,,,/Assets/icon.png">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource Sidebar}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,22,14,18">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Image Source="pack://application:,,,/Assets/icon.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="Paper Pilot" FontSize="18" FontWeight="ExtraBold" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="Nav" DockPanel.Dock="Top" />
                <Grid />
            </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
            <ContentControl x:Name="Page" Margin="38,30,38,40" MaxWidth="680" HorizontalAlignment="Left" Focusable="False" />
        </ScrollViewer>
    </Grid>
</Window>
